{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DemoManifestRecord",
  "description": "Schema for a single synthetic reference and hypothesis pair in the demo manifest.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the synthetic demo sample."
    },
    "reference": {
      "type": "string",
      "description": "Synthetic reference ground-truth text string."
    },
    "hypothesis": {
      "type": "string",
      "description": "Synthetic candidate hypothesis transcription string."
    }
  },
  "required": [
    "id",
    "reference",
    "hypothesis"
  ],
  "additionalProperties": false
}
